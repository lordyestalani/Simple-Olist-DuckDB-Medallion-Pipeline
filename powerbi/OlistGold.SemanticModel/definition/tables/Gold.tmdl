/// Delivered order item totals from the January–March 2018 Gold Parquet snapshot.
table Gold

	measure 'Merchandise sales' = SUM(Gold[Sales amount])
		formatString: "R$" #,##0.00

	measure 'Freight charges' = SUM(Gold[Freight amount])
		formatString: "R$" #,##0.00

	measure 'Freight share' = DIVIDE([Freight charges], [Merchandise sales])
		formatString: 0.00%

	column 'Purchase month'
		dataType: dateTime
		formatString: MMM yyyy
		summarizeBy: none
		sourceColumn: purchase_month

	column Month
		dataType: string
		summarizeBy: none
		sortByColumn: 'Purchase month'
		sourceColumn: month_label

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column 'Customer state'
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column 'Sales amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: merchandise_sales

	column 'Freight amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: freight_charges

	partition Gold = m
		mode: import
